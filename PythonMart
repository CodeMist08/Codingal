print("========================================")
print("       WELCOME TO PYTHON MART")
print("========================================\n")

categories = {
    "Electronics": {
        "Mouse": [500, 10],
        "Keyboard": [800, 8],
        "Headphones": [1200, 6],
        "Webcam": [1500, 5],
        "Speaker": [1000, 7]
    },

    "Clothing": {
        "T-Shirt": [600, 15],
        "Jeans": [1500, 10],
        "Jacket": [2500, 5],
        "Cap": [300, 20],
        "Shoes": [2000, 8]
    },

    "Books": {
        "Python": [500, 10],
        "Java": [600, 8],
        "HTML": [400, 12],
        "CSS": [450, 10],
        "JavaScript": [700, 7]
    },

    "Gaming": {
        "Controller": [2500, 5],
        "Gaming Mouse": [1800, 6],
        "Gaming Keyboard": [3000, 4],
        "Headset": [2200, 5],
        "Mouse Pad": [700, 10]
    },

    "Stationery": {
        "Notebook": [100, 30],
        "Pen": [20, 50],
        "Pencil": [10, 50],
        "Bag": [1000, 8],
        "Calculator": [800, 6]
    }
}
customers_served = 0
orders_completed = 0
total_items_sold = 0
total_revenue = 0

sales = {}

for category in categories:
    for product in categories[category]:
        sales[product] = 0

shopping = True

while shopping:

    print("\n========================================")
    print("          NEW CUSTOMER")
    print("========================================")

    name = input("Enter customer name: ")

    cart = {}
    cart_total = 0

    buying = True

    while buying:

        print("\n========== CATEGORIES ==========")

        category_list = list(categories.keys())

        for i in range(len(category_list)):
            print(i + 1, ".", category_list[i])

        print("0 . Checkout")

        choice = int(input("\nChoose a category: "))

        if choice == 0:
            buying = False
            continue

        if choice < 1 or choice > len(category_list):
            print("Invalid category!")
            continue

        category = category_list[choice - 1]

        print("\n==========", category, "==========")

        products = list(categories[category].keys())

        for i in range(len(products)):

            product = products[i]
            price = categories[category][product][0]
            stock = categories[category][product][1]

            print(
                i + 1,
                ".",
                product,
                "- ₹", price,
                "| Stock:", stock
            )

        product_choice = int(input("\nChoose a product: "))

        if product_choice < 1 or product_choice > len(products):
            print("Invalid product!")
            continue

        product = products[product_choice - 1]

        price = categories[category][product][0]
        stock = categories[category][product][1]

        quantity = int(input("Enter quantity: "))

        if quantity <= 0:
            print("Invalid quantity!")
            continue

        if quantity > stock:
            print("Not enough stock available!")
            continue

        if product in cart:
            cart[product] += quantity
        else:
            cart[product] = quantity

        cart_total += price * quantity

        categories[category][product][1] -= quantity

        print(
            quantity,
            product,
            "added to cart."
        )
        more = input(
            "Do you want to buy another product? (yes/no): "
        ).lower()

        if more != "yes":
            buying = False

    if len(cart) == 0:

        print("\nYour cart is empty.")

    else:

        print("\n========================================")
        print("             FINAL BILL")
        print("========================================")

        print("Customer:", name)
        print("----------------------------------------")

        for product in cart:

            quantity = cart[product]

            for category in categories:

                if product in categories[category]:

                    price = categories[category][product][0]

                    break

            item_total = price * quantity

            print(
                product,
                "x", quantity,
                "= ₹", item_total
            )
            sales[product] += quantity

            total_items_sold += quantity


        print("----------------------------------------")


        if cart_total >= 10000:

            discount = cart_total * 0.10
            print("Discount (10%): ₹", discount)

        elif cart_total >= 5000:

            discount = cart_total * 0.05
            print("Discount (5%): ₹", discount)

        else:

            discount = 0
            print("Discount: ₹0")


        after_discount = cart_total - discount

        tax = after_discount * 0.18

        final_amount = after_discount + tax

        print("Subtotal :", "₹", cart_total)
        print("Discount :", "₹", discount)
        print("Tax (18%):", "₹", tax)
        print("----------------------------------------")
        print("FINAL BILL:", "₹", final_amount)

        print("\nThank you,", name + "!")


        # Update daily statistics
        customers_served += 1
        orders_completed += 1
        total_revenue += final_amount

    print()

    again = input(
        "Serve another customer? (yes/no): "
    ).lower()

    if again != "yes":
        shopping = False

print("\n\n========================================")
print("          DAILY SHOP REPORT")
print("========================================")

print("Customers served :", customers_served)
print("Orders completed :", orders_completed)
print("Items sold       :", total_items_sold)
print("Total revenue    : ₹", total_revenue)


print("\n========== PRODUCT SALES ==========")

for category in categories:

    print("\n", category)

    for product in categories[category]:

        print(
            product,
            ":",
            sales[product],
            "sold"
        )

print("\n========== REMAINING STOCK ==========")

for category in categories:

    print("\n", category)

    for product in categories[category]:

        stock = categories[category][product][1]

        print(
            product,
            ":",
            stock,
            "remaining"
        )


print("\n========================================")
print("       SHOP SYSTEM CLOSED")
print("========================================")
